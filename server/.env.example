# Server settings (read by server/src/config.ts). Copy to .env to change them,
# or set them in the container environment.

# Port the WebSocket server listens on.
PORT=8080

# Folder with the track JSON files (default: the repo's app/assets/tracks).
# TRACKS_DIR=/data/tracks

# Folder for sessions saved from the lobby editor (default: server/sessions/saved).
# SAVED_SESSIONS_DIR=/data/sessions

# Delete a lobby with no drivers and no viewers after this many seconds.
# EMPTY_LOBBY_SECONDS=600

# The track editor's password (sent by the editor as X-Editor-Password).
# Not set = track editing is off. Only keeps editing to one person.
# EDITOR_PASSWORD=change-me
