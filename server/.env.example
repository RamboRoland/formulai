# Server settings (read by server/src/config.ts). Copy to .env to change them,
# or set them in the container environment.

# Port the WebSocket server listens on.
PORT=8080

# Delete a lobby with no drivers and no viewers after this many seconds.
# EMPTY_LOBBY_SECONDS=600

# The track editor's password (sent by the editor as X-Editor-Password).
# Not set = track editing is off. Only keeps editing to one person.
# EDITOR_PASSWORD=change-me

# Fast training lobbies (lockstep; one takes a whole core). false = off
# (e.g. a public server — run fast training locally).
# FAST_LOBBIES=true

# Incident logs: a car's last seconds around a spin or a crash, written to
# the bucket under logs/incidents/ (deleted after 30 days, daily). Off by
# default; read them with `npm run incidents`.
# LOG_INCIDENTS=true

# The S3 bucket the server keeps its data in (default: the local S3 of
# docker-compose.yml — `docker compose up -d s3`, then `npm run seed`).
# S3_ENDPOINT=http://localhost:9100   (set but empty = AWS S3 itself)
# S3_REGION=us-east-1
# S3_BUCKET=formulai
# S3_ACCESS_KEY_ID=formulai
# S3_SECRET_ACCESS_KEY=formulai-local
# S3_FORCE_PATH_STYLE=true
