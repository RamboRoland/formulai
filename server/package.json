{
  "name": "formula-ai-server",
  "version": "1.0.0",
  "description": "WebSocket server for Formula AI racing game",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --env-file-if-exists=.env -r ts-node/register src/index.ts",
    "build": "tsc",
    "dev": "nodemon --exec \"node --env-file-if-exists=.env -r ts-node/register\" src/index.ts",
    "test-agent": "node --env-file-if-exists=.env -r ts-node/register scripts/testAgent.ts"
  },
  "nodemonConfig": {
    "ignore": ["tracks/", "sessions/saved/"]
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
} 