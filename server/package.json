{
  "name": "formula-ai-server",
  "version": "1.0.0",
  "description": "WebSocket server for Formula AI racing game",
  "main": "src/index.ts",
  "scripts": {
    "start": "node --env-file-if-exists=.env -r ts-node/register src/index.ts",
    "build": "tsc",
    "dev": "nodemon --exec \"node --env-file-if-exists=.env -r ts-node/register\" src/index.ts",
    "test-agent": "node --env-file-if-exists=.env -r ts-node/register scripts/testAgent.ts",
    "seed": "node --env-file-if-exists=.env -r ts-node/register scripts/seed.ts",
    "fetch": "node --env-file-if-exists=.env -r ts-node/register scripts/fetch.ts",
    "laptimes": "node --env-file-if-exists=.env -r ts-node/register scripts/laptimes.ts",
    "rename-kart": "node --env-file-if-exists=.env -r ts-node/register scripts/renameKart.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
