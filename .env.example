# App settings (read by app/config.ts). Copy to .env to change them.
# Vite reads .env in `npm run dev` and bakes it in at `npm run build`.

# The WebSocket server the app connects to — its PUBLIC address.
VITE_WS_URL=ws://localhost:8080

# The same server's HTTP API (default: VITE_WS_URL with ws → http).
# VITE_API_URL=http://localhost:8080
