# Copy to deploy/.env on the server and fill in (never commit .env).

# The public name (a DNS A record → the server's IP; or an sslip.io name).
# The App, the game server's API (/api) and WebSocket (/ws) all live here.
APP_DOMAIN=formulai.example.com

# Basic auth in front of everything (browser login; agents send an
# Authorization header). The hash, not the password:
#   docker run --rm caddy:2.10 caddy hash-password --plaintext '<password>'
# Keep the hash in SINGLE quotes (it contains $).
BASIC_AUTH_USER=formulai
BASIC_AUTH_HASH='$2a$14$...'

# The images the deploy workflow pushes (GitHub Container Registry;
# owner in lower case).
SERVER_IMAGE=ghcr.io/ramboroland/formulai-server:latest
APP_IMAGE=ghcr.io/ramboroland/formulai-app:latest

# The track editor's password (the Track / Background API). Long and random.
EDITOR_PASSWORD=

# DigitalOcean Spaces: the Space's region endpoint, its name, and a Spaces
# access key (API → Spaces Keys). Region stays us-east-1 (the SDK needs one;
# Spaces goes by the endpoint).
S3_ENDPOINT=https://ams3.digitaloceanspaces.com
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
