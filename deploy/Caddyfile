# Caddy: HTTPS for the one domain (deploy/.env), everything behind basic
# auth. The game server sits under the App's domain, so the browser's
# login also covers the API and the WebSocket. The App's image has these
# addresses baked in (VITE_WS_URL = wss://APP_DOMAIN/ws, VITE_API_URL =
# https://APP_DOMAIN, set by the deploy workflow).

{$APP_DOMAIN} {
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	# The game server: the HTTP API + the WebSocket (formulai). It takes
	# the WebSocket on any path; /ws keeps it apart from the App's pages.
	@game path /api/* /ws
	handle @game {
		reverse_proxy server:8080
	}

	handle {
		encode zstd gzip
		reverse_proxy app:3000
	}
}
